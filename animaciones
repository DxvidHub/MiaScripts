local function ApplyAnimsFE(ids)
    local char = LP.Character or LP.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")
    local animate = char:WaitForChild("Animate")

    if animate then
        for _, v in pairs(hum:GetPlayingAnimationTracks()) do v:Stop(0.1) end
        pcall(function()
            if ids.idle1 then animate.idle.Animation1.AnimationId = "rbxassetid://"..tostring(ids.idle1) end
            if ids.idle2 then animate.idle.Animation2.AnimationId = "rbxassetid://"..tostring(ids.idle2) end
            if ids.walk then animate.walk.WalkAnim.AnimationId   = "rbxassetid://"..tostring(ids.walk) end
            if ids.run then animate.run.RunAnim.AnimationId     = "rbxassetid://"..tostring(ids.run) end
            if ids.jump then animate.jump.JumpAnim.AnimationId   = "rbxassetid://"..tostring(ids.jump) end
            if ids.fall then animate.fall.FallAnim.AnimationId   = "rbxassetid://"..tostring(ids.fall) end
        end)
        animate.Enabled = false
        task.wait(0.1)
        animate.Enabled = true
        hum:ChangeState(Enum.HumanoidStateType.Landed)
    end
end

local function PlayEmoteFE(emoteName, emoteId)
    pcall(function()
        local humanoid = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        local desc = humanoid and humanoid:FindFirstChildOfClass("HumanoidDescription")
        
        if desc then
            local currentEmotes = desc:GetEmotes()
            currentEmotes[emoteName] = {emoteId}
            desc:SetEmotes(currentEmotes)
            task.wait(0.05)
            humanoid:PlayEmote(emoteName)
        else
            local anim = Instance.new("Animation")
            anim.AnimationId = "rbxassetid://" .. tostring(emoteId)
            local track = humanoid:LoadAnimation(anim)
            track:Play()
        end
    end)
end

