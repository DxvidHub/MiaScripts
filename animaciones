local function UpdateList(searchText)
    searchText = searchText:lower()
    
    for _, item in pairs(Scroll:GetChildren()) do if item:IsA("Frame") then item:Destroy() end end
    for _, item in pairs(EmoteScroll:GetChildren()) do if item:IsA("TextButton") then item:Destroy() end end
    
    if CurrentTab == "Animaciones" then
        for _, anim in pairs(OriginalAnims) do
            if anim.name:lower():find(searchText) then CreateButton(anim.name, anim.ids) end
        end
    elseif CurrentTab == "Emotes" then
        for _, emote in pairs(MisEmotesPropios) do
            if emote.name:lower():find(searchText) then CreateEmoteButton(emote.name, emote.id) end
        end
    end
end

